# Clearway — environment reference.
# Copy to .env.local for development. NEVER commit a filled-in .env.
# Every variable is parsed through a Zod schema at boot (src/lib/env.ts);
# a missing required value or a malformed one fails the boot with a readable message.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Canonical public origin. Required in production (metadata, sitemap, CSP).
APP_URL=http://localhost:3000

# ─── Data (optional — unset uses in-process fallbacks) ───────────────────────
# Unset DATABASE_URL -> in-memory ring-buffer store. Set for durable telemetry.
# DATABASE_URL=postgres://clearway:clearway@localhost:5432/clearway
# Unset REDIS_URL -> in-memory cache + rate limiter. Set for shared, multi-instance.
# REDIS_URL=redis://localhost:6379

# ─── Privacy ─────────────────────────────────────────────────────────────────
# >=32 bytes. Salts the SHA-256 of URLs and IPs at rest. Rotating it anonymises history.
# A dev-only default is used when unset in development; REQUIRED in production.
RESOLVE_HASH_SALT=dev-only-insecure-salt-change-me-in-production-1234

# ─── Admin (optional — unset makes /admin return 404) ────────────────────────
# Generate with: npm run admin:hash
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt-hex>$<hash-hex>
# >=32 bytes, signs the admin session JWT.
# ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-min-32-bytes

# ─── Metrics (optional) ──────────────────────────────────────────────────────
# When set, /api/metrics requires: Authorization: Bearer <token>
# METRICS_TOKEN=

# ─── Networking / proxy ──────────────────────────────────────────────────────
# Hops of X-Forwarded-For to trust for the real client IP. Set to your proxy depth.
TRUSTED_PROXY_COUNT=0
# Comma-separated destination hosts to block outright.
# BLOCKED_HOSTS=
# Extra outbound ports beyond 80/443. Use sparingly.
# EXTRA_ALLOWED_PORTS=

# ─── Resolver budgets ────────────────────────────────────────────────────────
RESOLVE_TIMEOUT_MS=15000
STEP_TIMEOUT_MS=6000
MAX_HOPS=10
MAX_RESPONSE_BYTES=2097152

# ─── Rate limits (per 60s window unless noted) ───────────────────────────────
RATE_LIMIT_RESOLVE=30
RATE_LIMIT_READ=120

# ─── Cache TTLs (seconds) ────────────────────────────────────────────────────
CACHE_TTL_SUCCESS_S=3600
CACHE_TTL_FAILURE_S=60

# ─── Retention ───────────────────────────────────────────────────────────────
RETENTION_DAYS=30

# ─── Circuit breaker ─────────────────────────────────────────────────────────
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=60000
BREAKER_MAX_COOLDOWN_MS=900000

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug exposes full URLs — never in production.
LOG_LEVEL=info
